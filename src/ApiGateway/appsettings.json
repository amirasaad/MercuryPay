{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "ReverseProxy": {
    "Routes": {
      "payments": {
        "ClusterId": "paymentservice",
        "AuthorizationPolicy": "Authenticated",
        "Match": { "Path": "/payments/{**catch-all}" }
      },
      "wallets": {
        "ClusterId": "walletservice",
        "AuthorizationPolicy": "Authenticated",
        "Match": { "Path": "/wallets/{**catch-all}" }
      },
      "loans": {
        "ClusterId": "lendingservice",
        "AuthorizationPolicy": "Authenticated",
        "Match": { "Path": "/loans/{**catch-all}" }
      },
      "risks": {
        "ClusterId": "riskservice",
        "AuthorizationPolicy": "Authenticated",
        "Match": { "Path": "/risks/{**catch-all}" }
      }
    },
    "Clusters": {
      "paymentservice": {
        "Destinations": {
          "d1": { "Address": "http://paymentservice" }
        }
      },
      "walletservice": {
        "Destinations": {
          "d1": { "Address": "http://walletservice" }
        }
      },
      "lendingservice": {
        "Destinations": {
          "d1": { "Address": "http://lendingservice" }
        }
      },
      "riskservice": {
        "Destinations": {
          "d1": { "Address": "http://riskservice" }
        }
      }
    }
  }
}
