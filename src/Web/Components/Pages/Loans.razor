@page "/loans"
@using MercuryPay.Web
@using Microsoft.AspNetCore.Authorization
@using Microsoft.AspNetCore.Components.Authorization
@using System.Security.Claims
@attribute [Authorize]
@inject LendingApiClient LendingApi
@inject NavigationManager Navigation
@inject AuthenticationStateProvider AuthenticationStateProvider

<PageTitle>Apply for Loan</PageTitle>

<h1>Apply for a Loan</h1>

<p>Enter the amount you wish to borrow.</p>

@if (successMessage != null)
{
    <div class="alert alert-success">@successMessage</div>
}

@if (errorMessage != null)
{
    <div class="alert alert-danger">@errorMessage</div>
}

<EditForm Model="@(loanModel!)" OnValidSubmit="HandleSubmit" FormName="LoanForm">
    <DataAnnotationsValidator />
    <ValidationSummary />

    <div class="mb-3">
        <label for="amount" class="form-label">Amount</label>
        <InputNumber id="amount" class="form-control" @bind-Value="loanModel!.Amount" />
    </div>

    <div class="mb-3">
        <label for="currency" class="form-label">Currency</label>
        <InputText id="currency" class="form-control" @bind-Value="loanModel!.Currency" />
    </div>

    <button type="submit" class="btn btn-primary">Apply</button>
</EditForm>

<hr class="my-5" />

<h2>Your Loans</h2>

@if (userLoans == null)
{
    <p><em>Loading...</em></p>
}
else if (!userLoans.Any())
{
    <p>No loans found.</p>
}
else
{
    <table class="table">
        <thead>
            <tr>
                <th>ID</th>
                <th>Amount</th>
                <th>Currency</th>
                <th>Status</th>
                <th>Date</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var loan in userLoans)
            {
                <tr>
                    <td>@loan.Id</td>
                    <td>@loan.Amount</td>
                    <td>@loan.Currency</td>
                    <td>
                    <span class="badge @GetStatusBadgeClass(loan.Status)">
                        @loan.Status
                    </span>
                    @if (loan.Status == "DisbursementFailed")
                    {
                        <button class="btn btn-sm btn-outline-danger ms-2" @onclick="() => RetryDisbursement(loan.Id)">
                            Retry
                        </button>
                    }
                </td>
                <td>@loan.CreatedAt.ToLocalTime().ToString("g")</td>
            </tr>
        }
    </tbody>
</table>
}

@code {
    [SupplyParameterFromForm]
    private LoanViewModel? loanModel { get; set; }
    
    private List<LoanResponseModel>? userLoans;
    private string? userId;
    private string? successMessage;
    private string? errorMessage;

    protected override async Task OnInitializedAsync()
    {
        var authState = await AuthenticationStateProvider.GetAuthenticationStateAsync();
        userId = authState.User.FindFirst(ClaimTypes.NameIdentifier)?.Value;

        loanModel ??= new LoanViewModel();
        await LoadLoans();
    }

    private async Task LoadLoans()
    {
        try
        {
            userLoans = await LendingApi.GetMyLoansAsync();
        }
        catch (Exception ex)
        {
            errorMessage = $"Error loading loans: {ex.Message}";
        }
    }

    private async Task HandleSubmit()
    {
        successMessage = null;
        errorMessage = null;

        if (loanModel!.Amount <= 0)
        {
            errorMessage = "Amount must be positive.";
            return;
        }

        var request = new LoanRequestModel(userId ?? "unknown", loanModel.Amount, loanModel.Currency);
        var result = await LendingApi.CreateLoanAsync(request);

        if (result != null)
        {
            successMessage = "Loan application submitted successfully!";
            loanModel = new LoanViewModel(); // Reset form
            await LoadLoans();
        }
        else
        {
            errorMessage = "Failed to submit loan application.";
        }
    }

    private async Task RetryDisbursement(Guid loanId)
    {
        try
        {
            var success = await LendingApi.RetryLoanDisbursementAsync(loanId);
            if (success)
            {
                successMessage = "Retry initiated successfully.";
                await LoadLoans();
            }
            else
            {
                errorMessage = "Retry failed.";
            }
        }
        catch (Exception ex)
        {
            errorMessage = $"Error retrying: {ex.Message}";
        }
    }

    private string GetStatusBadgeClass(string status) => status switch
    {
        "Approved" => "bg-success",
        "Rejected" => "bg-danger",
        "DisbursementFailed" => "bg-warning text-dark",
        "Processing" => "bg-info text-dark",
        _ => "bg-secondary"
    };

    public class LoanViewModel
    {
        public decimal Amount { get; set; } = 1000;
        public string Currency { get; set; } = "USD";
    }
}
