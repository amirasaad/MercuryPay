{
  "name": "aspireapp",
  "version": "1.2.0",
  "description": "Intelligent financial orchestration platform for payments, wallets, lending, and risk — built with .NET Aspire as event-driven microservices.",
  "main": "index.js",
  "scripts": {
    "test": "echo \"Error: no test specified\" && exit 1",
    "commit": "cz",
    "prepare": "husky",
    "release": "node scripts/release.mjs"
  },
  "config": {
    "commitizen": {
      "path": "cz-emoji"
    },
    "cz-emoji": {
      "conventional": true,
      "types": [
        {
          "emoji": "✨",
          "code": ":sparkles:",
          "description": "A new feature",
          "name": "feat"
        },
        {
          "emoji": "🐛",
          "code": ":bug:",
          "description": "A bug fix",
          "name": "fix"
        },
        {
          "emoji": "📝",
          "code": ":memo:",
          "description": "Documentation only changes",
          "name": "docs"
        },
        {
          "emoji": "💄",
          "code": ":lipstick:",
          "description": "Changes that do not affect the meaning of the code",
          "name": "style"
        },
        {
          "emoji": "♻️",
          "code": ":recycle:",
          "description": "A code change that neither fixes a bug nor adds a feature",
          "name": "refactor"
        },
        {
          "emoji": "⚡️",
          "code": ":zap:",
          "description": "A code change that improves performance",
          "name": "perf"
        },
        {
          "emoji": "✅",
          "code": ":white_check_mark:",
          "description": "Adding missing tests or correcting existing tests",
          "name": "test"
        },
        {
          "emoji": "📦",
          "code": ":package:",
          "description": "Changes that affect the build system or external dependencies",
          "name": "build"
        },
        {
          "emoji": "🎡",
          "code": ":ferris_wheel:",
          "description": "Changes to our CI configuration files and scripts",
          "name": "ci"
        },
        {
          "emoji": "🔨",
          "code": ":hammer:",
          "description": "Other changes that don't modify src or test files",
          "name": "chore"
        },
        {
          "emoji": "⏪️",
          "code": ":rewind:",
          "description": "Reverts a previous commit",
          "name": "revert"
        }
      ]
    }
  },
  "keywords": [],
  "repository": {
    "type": "git",
    "url": "https://github.com/user/MercuryPay.git"
  },
  "author": "",
  "license": "ISC",
  "devDependencies": {
    "@commitlint/cli": "^20.4.3",
    "@commitlint/config-conventional": "^20.4.3",
    "@simple-release/core": "^2.4.0",
    "@simple-release/npm": "^2.3.0",
    "commitizen": "^4.3.1",
    "conventional-changelog-cli": "^5.0.0",
    "conventional-changelog-cz-emoji": "^2.0.1",
    "cz-emoji": "^1.3.2-canary.2",
    "cz-git": "^1.12.0",
    "husky": "^9.1.7"
  }
}
